{
  "name": "harwood-foundry-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://thomas-harwood.com,https://cureositylabs.com",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "LIVE_ENABLED": "false",
    "DAILY_LIMIT": "50",
    "PER_IP_HOURLY_LIMIT": "3",
    "LEADS_ENABLED": "false",
    "LEAD_FROM": "leads@cureositylabs.com",
    "LEAD_TO": "REPLACE_WITH_VERIFIED_DESTINATION"
  },
  "send_email": [{ "name": "LEAD_EMAIL", "destination_address": "REPLACE_WITH_VERIFIED_DESTINATION" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "harwood-foundry-usage",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
  }]
}
